{
  "name": "yt-waypoints",
  "version": "3.0.0-alpha.1",
  "private": true,
  "description": "Local YouTube bookmarks and resume points for Firefox, Chrome, and Brave.",
  "scripts": {
    "build": "python3 scripts/build.py",
    "build:firefox": "python3 scripts/build.py firefox",
    "build:chrome": "python3 scripts/build.py chrome",
    "test": "node tests/run.cjs",
    "dev": "wxt -b chrome --mv3",
    "dev:firefox": "wxt -b firefox --mv3",
    "postinstall": "wxt prepare",
    "check": "node tests/quality.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "vite": "7.3.8",
    "wxt": "0.21.5"
  }
}
